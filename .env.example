# Database
DATABASE_URL=postgresql://user:password@localhost:5432/batch_picking

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# WooCommerce
WOO_API_URL=https://your-store.com
WOO_CONSUMER_KEY=ck_xxxxx
WOO_CONSUMER_SECRET=cs_xxxxx
WOO_WEBHOOK_SECRET=your_webhook_secret_here

# How many days back to sync 'processing' orders from (default: 7)
SYNC_DAYS_BACK=7

# Supabase (server only; the browser never talks to Supabase, see docs/RLS-PRELAZAK.md)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Secret / service_role key. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Transition fallback only, used while SUPABASE_SERVICE_ROLE_KEY is not set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# OpenRouter AI
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_FALLBACK_MODEL=google/gemini-3.5-flash-lite

